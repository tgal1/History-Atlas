    "markers": [
      {"t": 0, "at": [37.236, -76.508], "label": "Cornwallis fortifies Yorktown", "color": "#c8372d"},
      {"t": 0, "until": 20, "at": [40.75, -73.98], "label": "Clinton holds New York", "color": "#c8372d"},
      {"t": 0, "until": 26, "at": [37.32, -76.8], "label": "Lafayette watches Cornwallis", "color": "#2f6fb5"},
      {"t": 9, "until": 14, "at": [40.74, -74.383], "label": "Decoy camp and bread ovens", "color": "#f4f1e8"},
      {"t": 11, "at": [36.92, -76.05], "label": "De Grasse's fleet arrives", "color": "#7a5ab8"},
      {
        "t": 17,
        "until": 22,
        "at": [36.85, -75.7],
        "label": "Battle of the Chesapeake",
        "color": "#2f86d6",
        "pulse": true
      },
      {"t": 40, "at": [37.215, -76.52], "label": "Siege begins", "color": "#2f6fb5", "pulse": true}
    ],
    "captions": [
      {
        "t": 0,
        "text": "19 August 1781. About 2,500 Continentals and 4,000 French troops leave their camps near Dobbs Ferry, just north of British-held New York."
      },
      {
        "t": 2,
        "text": "They cross the Hudson at King's Ferry. Getting the men, guns and wagons over takes about a week."
      },
      {
        "t": 7.5,
        "text": "The columns head south through New Jersey as if to attack New York from Staten Island. Near Chatham the French build bread ovens for a camp that will never be used."
      },
      {
        "t": 12,
        "text": "Clinton realises too late where they are going. Admiral Graves sails from New York to find the French fleet."
      },
      {
        "t": 14,
        "text": "The Continentals march through Philadelphia on 2 September, the French the next day, watched by crowds and by Congress."
      },
      {
        "t": 17,
        "text": "5 September. At Chester, Washington hears that de Grasse is in the Chesapeake with 28 ships of the line and waves his hat in delight. That afternoon the fleets fight off the Virginia Capes."
      },
      {
        "t": 19.5,
        "text": "At Head of Elk there are too few boats. Some troops sail down the bay; the rest march on to Baltimore and Annapolis to find ships. Washington rides ahead and spends his first nights at Mount Vernon in six years."
      },
      {
        "t": 26,
        "text": "Washington reaches Williamsburg on 14 September and joins Lafayette, who has been shadowing Cornwallis all summer."
      },
      {
        "t": 29,
        "text": "Graves's damaged fleet turns back for New York. Transports carry the troops and siege guns down the bay to the James River."
      },
      {
        "t": 36,
        "text": "The allied army gathers at Williamsburg: about 16,000 Americans and French against Cornwallis's 9,000."
      },
      {
        "t": 39.5,
        "text": "28 September. The allies march the 12 miles to Yorktown and close the ring. Three weeks later Cornwallis surrenders."
      }
    ]
  }
}
