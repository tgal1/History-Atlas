    "captions": [
      { "t": 0.00, "text": "1 January: about 40 students from People's Democracy set off from Belfast City Hall." },
      { "t": 0.80, "text": "Loyalist counter-protesters and police block the road at Antrim. The march is re-routed again and again." },
      { "t": 1.60, "text": "Numbers grow to a few hundred as the march crosses into Co. Londonderry." },
      { "t": 2.90, "text": "3 January: the marchers rest at Claudy. Loyalists gather stones and clubs on the hills ahead." },
      { "t": 3.30, "text": "4 January: at Burntollet Bridge about 200 loyalists, some of them off-duty B-Specials, attack. Police largely stand by." },
      { "t": 3.60, "text": "Bloodied marchers struggle on into Derry. Rioting follows that night." }
    ]
